[Unit]
Description=Antra Customer Order Management Next.js App
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/websites/antra
Environment=NODE_ENV=production
Environment=PORT=3001
ExecStart=/usr/bin/npx next start -H 127.0.0.1 -p 3001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
