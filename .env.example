# Antra Application Environment Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=antra_secret_jwt_key_secure_2026_x87

# PostgreSQL Database Configuration
# You can either set DATABASE_URL or individual PG* variables
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/company_database
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD
PGDATABASE=company_database
PGSCHEMA=antra
